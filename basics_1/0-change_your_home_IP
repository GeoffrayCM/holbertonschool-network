#!/usr/bin/env bash
# Configures an Ubuntu server: localhost=127.0.0.2, facebook.com=8.8.8.8

# Remplace l'entrée localhost existante
sed -i 's/127\.0\.0\.1\s*localhost/127.0.0.2 localhost/' /etc/hosts

# Ajoute facebook.com s'il n'existe pas déjà, sinon le remplace
if grep -q "facebook.com" /etc/hosts; then
    sed -i 's/.*facebook\.com.*/8.8.8.8 facebook.com/' /etc/hosts
else
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi
